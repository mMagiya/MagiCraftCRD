{
    "model": {
        "type": "minecraft:condition",
        "on_false": {
            "type": "minecraft:condition",
            "property": "minecraft:has_component",
            "component": "minecraft:custom_name",
            "on_true": {
                "type": "minecraft:select",
                "model": "minecraft:item/shield",
                "property": "minecraft:component",
                "component": "minecraft:custom_name",
                "cases": [
                    {
                        "when": "Captain Dude Shield",
                        "model": {
                            "type": "minecraft:model",
                            "model": "magicraft:item/captdudeshield"
                        }
                    },
                    {
                        "when": "Personal Defense Matrix",
                        "model": {
                            "type": "minecraft:model",
                            "model": "magicraft:item/pdmwatch"
                        }
                    }
                ],
                "fallback": {
                    "type": "minecraft:special",
                    "base": "minecraft:item/shield",
                    "model": {
                        "type": "minecraft:shield"
                    }
                }
            },
            "on_false": {
                "type": "minecraft:special",
                "base": "minecraft:item/shield",
                "model": {
                    "type": "minecraft:shield"
                }
            }
        },
        "on_true": {
            "type": "minecraft:condition",
            "property": "minecraft:has_component",
            "component": "minecraft:custom_name",
            "on_true": {
                "type": "minecraft:select",
                "model": "minecraft:item/shield_blocking",
                "property": "minecraft:component",
                "component": "minecraft:custom_name",
                "cases": [
                    {
                        "when": "Captain Dude Shield",
                        "model": {
                            "type": "minecraft:model",
                            "model": "magicraft:item/captdudeshield_blocking"
                        }
                    },
                    {
                        "when": "Personal Defense Matrix",
                        "model": {
                            "type": "minecraft:model",
                            "model": "magicraft:item/pdmwatch_blocking"
                        }
                    }
                ],
                "fallback": {
                    "type": "minecraft:special",
                    "base": "minecraft:item/shield_blocking",
                    "model": {
                        "type": "minecraft:shield"
                    }
                }
            },
            "on_false": {
                "type": "minecraft:special",
                "base": "minecraft:item/shield_blocking",
                "model": {
                    "type": "minecraft:shield"
                }
            }
        },
        "property": "minecraft:using_item"
    }
}