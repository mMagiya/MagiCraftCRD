{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "model",
      "model": "block/carved_pumpkin"
    },
    "cases": [
      { "when": "hc_bighat", "model": { "type": "model", "model": "hermitcraft:item/bighat" } },
      { "when": "hc_creeper", "model": { "type": "model", "model": "hermitcraft:item/creeper_costume" } },
      { "when": "magi_horns", "model": { "type": "model", "model": "magicraft:item/magiyahorns" } },
      { "when": "magi_gorilla", "model": { "type": "model", "model": "magicraft:item/gorilla" } },
      { "when": "magi_gorilla_mask", "model": { "type": "model", "model": "magicraft:item/gorilla_mask" } },
    ]
  }
}